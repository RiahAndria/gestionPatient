<Window x:Class="Patients.Views.Patient.Windows.EditPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier le patient" 
        Height="Auto" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <!-- Ombre et fond blanc arrondi pour l'effet Popup moderne -->
    <Border Background="White" CornerRadius="12" Margin="15">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="20" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel Margin="24">

            <!-- En-tête avec titre et bouton Fermer -->
            <DockPanel Margin="0,0,0,20">
                <Button Content="✕" Click="btnAnnuler_Click" DockPanel.Dock="Right" 
                        Background="Transparent" Foreground="#6B7280" FontSize="16" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Width="30" Height="30"/>
                
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Modifier le dossier patient" Style="{StaticResource TitreSection}" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Matricule : " Style="{StaticResource Libelle}" FontSize="12"/>
                        <TextBlock x:Name="txtMatriculeDisplay" Text="PAT-000" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,16"/>

            <!-- Formulaire de modification -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Nom *" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtNom" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Prénom *" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtPrenom" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Date de naissance *" Style="{StaticResource Libelle}"/>
                    <DatePicker x:Name="dpDateNaissance" Height="34" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Genre" Style="{StaticResource Libelle}"/>
                    <ComboBox x:Name="cbGenre" Style="{StaticResource ComboSaisie}">
                        <ComboBoxItem Content="Homme"/>
                        <ComboBoxItem Content="Femme"/>
                        <ComboBoxItem Content="Autre"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Adresse" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtAdressePatient" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Adresse e-mail" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtEmailPatient" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Numéro de téléphone" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtTelephonePatient" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="N° Assurance" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtNumAssurancePatient" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>
            </Grid>

            <!-- Message d'erreur/succès -->
            <TextBlock x:Name="txtMessage" Text="" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <!-- Boutons d'actions (Annuler / Enregistrer) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Annuler" Click="btnAnnuler_Click" Style="{StaticResource BoutonSecondaire}"/>
                <Button Grid.Column="2" Content="Enregistrer" Click="btnEnregistrer_Click" Style="{StaticResource BoutonPrimaire}"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>