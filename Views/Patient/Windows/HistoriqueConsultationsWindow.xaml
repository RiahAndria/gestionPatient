<Window x:Class="Patients.Views.Patient.Windows.HistoriqueConsultationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historique des consultations"
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Historique des consultations" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock x:Name="txtPatient" FontSize="13" Foreground="#475569" Margin="0,4,0,0"/>
        </StackPanel>

        <DataGrid x:Name="dgHistorique" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White" BorderThickness="1" BorderBrush="#CBD5E1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding DateConsultation, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTextColumn Header="N° consultation" Binding="{Binding NumeroConsultation}" Width="130"/>
                <DataGridTextColumn Header="Diagnostic" Binding="{Binding Diagnostique}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
