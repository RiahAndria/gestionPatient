<Window x:Class="Patients.Views.Patient.DetailPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Dossier Médical Complet" Height="650" Width="900" 
        WindowStartupLocation="CenterScreen" AllowsTransparency="True" WindowStyle="None" Background="Transparent">

    <Window.Resources>
        <Style x:Key="GlassSection" TargetType="Border">
            <Setter Property="Background" Value="#B2FFFFFF"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.05" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="25" Background="#F0F4F8" BorderBrush="#2563EB" BorderThickness="1">
        <Grid>
            <Image Source="/Assets/bg.jpg" Stretch="UniformToFill" Opacity="0.1">
                <Image.Effect>
                    <BlurEffect Radius="20"/>
                </Image.Effect>
            </Image>

            <DockPanel Margin="20">
                <!-- En-tête : MODIFIÉ POUR S'ADAPTER AUTOMATIQUEMENT À LA TAILLE -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/> <!-- Colonne pour le nom (prend tout l'espace) -->
                            <ColumnDefinition Width="Auto"/> <!-- Colonne pour le bouton fermer -->
                        </Grid.ColumnDefinitions>

                        <!-- Infos Patient (Gauche) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,5,10,5">
                            <TextBlock x:Name="lblIdentite" FontSize="24" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap"/>
                            <TextBlock x:Name="lblMatricule" FontSize="14" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="lblDateNaissance" FontSize="13" Foreground="#475569" Margin="0,4,0,0"/>
                            <TextBlock x:Name="lblAgeGenre" FontSize="13" Foreground="#475569"/>
                        </StackPanel>

                        <!-- Bouton fermer (Droite, aligné en haut) -->
                        <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Click="BtnFermer_Click" Cursor="Hand" Margin="0,5,0,0">
                            <materialDesign:PackIcon Kind="CloseCircle" Foreground="#64748B" Width="24" Height="24"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Barre d'actions en bas -->
                <Border DockPanel.Dock="Bottom" Height="60" Margin="0,10,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Content="Modifier le patient" Click="BtnOuvrirModification_Click" Height="38" Width="170" Margin="0,0,10,0" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Supprimer" Click="BtnSupprimer_Click" Height="38" Width="130" Margin="0,0,10,0" Background="#DC2626" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                            <Button x:Name="btnHistorique" Content="Afficher l'historique" Click="BtnHistorique_Click" Height="38" Width="170" Background="#0F766E" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>

                        <Button Content="Fermer" Click="BtnFermer_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Height="38" Width="100" Background="#64748B" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Contenu principal organisé en 2 colonnes équilibrées -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Colonne de gauche : Infos Médicales -->
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource GlassSection}">
                            <StackPanel>
                                <TextBlock Text="Constantes Vitales" FontWeight="Bold" Margin="0,0,0,10" Foreground="#334155"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Poids" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock x:Name="lblPoids" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Taille" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock x:Name="lblTaille" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Groupe Sanguin" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock x:Name="lblGroupe" FontSize="18" FontWeight="Bold" Foreground="#DC2626"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassSection}">
                            <StackPanel>
                                <TextBlock Text="Traitements en cours" FontWeight="Bold" Margin="0,0,0,10" Foreground="#334155"/>
                                <TextBlock x:Name="txtTraitements" TextWrapping="Wrap" FontSize="14" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassSection}">
                            <StackPanel>
                                <TextBlock Text="Allergies &amp; Alertes" FontWeight="Bold" Margin="0,0,0,10" Foreground="#DC2626"/>
                                <TextBlock x:Name="txtAllergies" TextWrapping="Wrap" FontSize="14" Foreground="#991B1B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    

                    <!-- Colonne de droite : Coordonnées et Historique -->
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource GlassSection}">
                            <StackPanel>
                                <TextBlock Text="Contact &amp; Assurance" FontWeight="Bold" Margin="0,0,0,10" Foreground="#334155"/>
                                <TextBlock x:Name="lblContact" Margin="0,0,0,5" FontSize="13" TextWrapping="Wrap"/>
                                <Separator Background="#E2E8F0" Margin="0,8"/>
                                <TextBlock x:Name="lblAssurance" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassSection}">
                            <StackPanel>
                                <TextBlock Text="Antécédents Médicaux" FontWeight="Bold" Margin="0,0,0,10" Foreground="#334155"/>
                                <TextBlock x:Name="txtAntecedents" TextWrapping="Wrap" FontSize="13" MinHeight="150"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>