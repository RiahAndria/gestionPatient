<UserControl x:Class="Patients.Views.Patient.Forms.PatientFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Border Style="{StaticResource Carte}" Padding="24">
        <StackPanel>
            <!-- En-tête du formulaire -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Nouveau Patient" Style="{StaticResource TitreSection}" Margin="0"/>
                    <TextBlock Text="Ajouter un nouveau patient" Style="{StaticResource Libelle}" FontSize="12"/>
                </StackPanel>
            </DockPanel>

            <!-- Ligne 1 : Nom / Prénom -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Nom *" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtNom" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Prénom *" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtPrenom" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>
            </Grid>

            <!-- Ligne 2 : Date de naissance / Genre -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Date de naissance *" Style="{StaticResource Libelle}"/>
                    <DatePicker x:Name="dpDateNaissance" Height="34" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Genre" Style="{StaticResource Libelle}"/>
                    <ComboBox x:Name="cbGenre" Style="{StaticResource ComboSaisie}">
                        <ComboBoxItem Content="Homme"/>
                        <ComboBoxItem Content="Femme"/>
                        <ComboBoxItem Content="Autre" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Ligne 3 : Adresse / Email -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Adresse" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtAdressePatient" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Adresse e-mail" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtEmailPatient" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>
            </Grid>

            <!-- Ligne 4 : Téléphone / N° Assurance -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Numéro de téléphone" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtTelephonePatient" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="N° Sécurité Sociale / Assurance" Style="{StaticResource Libelle}"/>
                    <TextBox x:Name="txtNumAssurancePatient" Style="{StaticResource ChampSaisie}"/>
                </StackPanel>
            </Grid>

            <!-- Bouton d'action -->
            <Button Content="+ Ajouter le patient" Click="btnAjouter_Click" Style="{StaticResource BoutonPrimaire}" Height="38"/>

            <!-- Message d'état -->
            <TextBlock x:Name="txtMessage" Text="" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>