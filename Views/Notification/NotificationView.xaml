<UserControl x:Class="Patients.Views.Notification.NotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Patients.Views.Notification">

    <UserControl.Resources>
        <local:BoolInverseToVisibilityConverter x:Key="BoolInverseToVisibility"/>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="8" Padding="20">
        <StackPanel>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BellOutline" Width="22" Height="22" Foreground="#2563EB" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtTitre" Text="Notifications" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Click="BtnMarquerToutesLues_Click" Background="#F1F5F9" Foreground="#334155"
                            BorderThickness="0" Padding="12,7" Margin="0,0,8,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckAll" Width="15" Height="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Tout marquer comme lu" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Click="BtnGenererRappels_Click" Background="#2563EB" Foreground="White"
                            BorderThickness="0" Padding="12,7" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BellRingOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Générer les rappels (24h)" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Text="Double-clique sur une notification pour voir le rendez-vous concerné."
                       FontSize="11" Foreground="#94A3B8" FontStyle="Italic" Margin="0,0,0,14"/>

            <ItemsControl x:Name="ListeNotifications">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="4,12" Cursor="Hand"
                                MouseLeftButtonUp="Notification_Click" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Top" Margin="0,5,12,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#2563EB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Lu}" Value="True">
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding TexteNotif}" TextWrapping="Wrap" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Lu}" Value="True">
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DateNotif, StringFormat='dd/MM/yyyy à HH:mm'}"
                                               FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Marquer comme lue" FontSize="11" Padding="8,4"
                                        Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand"
                                        Click="BtnMarquerLue_Click" Tag="{Binding NumeroNotif}"
                                        Visibility="{Binding Lu, Converter={StaticResource BoolInverseToVisibility}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="TxtAucune" Text="Aucune notification pour le moment." FontSize="13"
                       Foreground="#94A3B8" FontStyle="Italic" Margin="0,20,0,0" HorizontalAlignment="Center"/>

        </StackPanel>
    </Border>
</UserControl>
