<Window x:Class="Patients.Views.Paiement.RejeterPaiementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rejeter le paiement" Height="300" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">

    <StackPanel Margin="20">
        <TextBlock x:Name="lblPatient" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
        <TextBlock x:Name="lblContexte" FontSize="12" Foreground="#64748B" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <TextBlock Text="Motif du rejet" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
        <TextBox x:Name="txtMotif" Height="70" Padding="8,6" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalContentAlignment="Top" Margin="0,0,0,14"/>

        <TextBlock x:Name="txtErreur" Foreground="Red" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Width="90" Height="34" Margin="0,0,10,0" Background="#F1F5F9" Foreground="#334155"
                    BorderThickness="0" Cursor="Hand" Click="BtnAnnuler_Click"/>
            <Button Content="Confirmer le rejet" Width="150" Height="34" Background="#DC2626" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnConfirmer_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
