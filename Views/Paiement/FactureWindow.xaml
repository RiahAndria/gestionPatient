<Window x:Class="Patients.Views.Paiement.FactureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Facture" Height="640" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#E2E8F0">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- "Papier" de facture -->
        <Border Grid.Row="0" Background="White" CornerRadius="4" Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.15" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Gestion Patient" FontSize="20" FontWeight="Bold" Foreground="#2563EB"/>
                <TextBlock Text="FACTURE" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2,0,20"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="N° FACTURE" FontSize="10" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblNumero" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="DATE" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="lblDate" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,1" Padding="0,14" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PATIENT" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblPatientNom" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblPatientMatricule" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="MÉDECIN" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblMedecinNom" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblMedecinFonction" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="lblLibelle" FontSize="13"/>
                    <TextBlock Grid.Column="1" x:Name="lblRdv" FontSize="11" Foreground="#94A3B8"/>
                </Grid>

                <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TOTAL RÉGLÉ" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" x:Name="lblMontant" FontSize="18" FontWeight="Bold" Foreground="#2563EB"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="lblMode" FontSize="12" Foreground="#64748B" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fermer" Width="100" Height="36" Margin="0,0,10,0" Background="#64748B" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnFermer_Click"/>
            <Button x:Name="BtnConfirmer" Content="Confirmer la facturation" Width="190" Height="36" Background="#2563EB" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnConfirmer_Click"/>
        </StackPanel>
    </Grid>
</Window>
