<!-- Vue pour la gestion des paiements -->
<UserControl x:Class="Patients.Views.Paiement.PaiementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="0,10,0,0">

        <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Foreground="#1E40AF" FontSize="12">
                Un paiement est créé automatiquement dès qu'une consultation est enregistrée (aucun paiement en avance).
                Après 3 relances et 7 jours sans règlement, les prochains rendez-vous du patient sont annulés automatiquement.
            </TextBlock>
        </Border>

        <!-- ===== Factures en attente ===== -->
        <Border Style="{StaticResource Carte}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Factures en attente" Style="{StaticResource TitreSection}"/>
                    <Button Grid.Column="1" Content="Traiter les impayés" Style="{StaticResource BoutonSecondaire}"
                            Click="btnTraiterImpayes_Click"/>
                </Grid>

                <DataGrid x:Name="dgEnAttente" Style="{StaticResource GrilleModerne}"
                          ColumnHeaderStyle="{StaticResource EnteteGrille}" Height="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° paiement" Binding="{Binding NumeroPaiement}" Width="110"/>
                        <DataGridTextColumn Header="Patient" Binding="{Binding PatientNom}" Width="*"/>
                        <DataGridTextColumn Header="Facturé le" Binding="{Binding DateFacture, StringFormat='dd/MM/yyyy'}" Width="100"/>
                        <DataGridTextColumn Header="Jours" Binding="{Binding JoursEcoules}" Width="60"/>
                        <DataGridTextColumn Header="Montant" Binding="{Binding MontantAffiche}" Width="110"/>
                        <DataGridTextColumn Header="Relances" Binding="{Binding NombreRelances}" Width="80"/>
                        <DataGridTemplateColumn Header="Actions" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Relancer" Style="{StaticResource BoutonSecondaire}"
                                                Margin="0,0,6,0" Click="btnRelancer_Click" Tag="{Binding NumeroPaiement}"/>
                                        <Button Content="Confirmer paiement" Style="{StaticResource BoutonSucces}"
                                                Click="btnConfirmer_Click" Tag="{Binding NumeroPaiement}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="txtMessage" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ===== Historique ===== -->
        <Border Style="{StaticResource Carte}">
            <StackPanel>
                <TextBlock Text="Historique des paiements réglés" Style="{StaticResource TitreSection}"/>
                <DataGrid x:Name="dgHistorique" Style="{StaticResource GrilleModerne}"
                          ColumnHeaderStyle="{StaticResource EnteteGrille}" Height="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° paiement" Binding="{Binding NumeroPaiement}" Width="110"/>
                        <DataGridTextColumn Header="Patient" Binding="{Binding PatientNom}" Width="*"/>
                        <DataGridTextColumn Header="Réglé le" Binding="{Binding DateFacture, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
                        <DataGridTextColumn Header="Montant" Binding="{Binding MontantAffiche}" Width="110"/>
                        <DataGridTextColumn Header="Mode" Binding="{Binding ModePaiement}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
