<UserControl x:Class="Patients.Views.Paiement.PaiementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Patients.Views.Paiement">

    <UserControl.Resources>
        <local:BoolInverseToVisibilityConverter x:Key="BoolInverseToVisibility"/>
    </UserControl.Resources>

    <StackPanel>

        <!-- Paiements non complets -->
        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <materialDesign:PackIcon Kind="ClockAlertOutline" Width="20" Height="20" Foreground="#2563EB" Margin="0,0,8,0"/>
                    <TextBlock Text="Paiements non complets" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                </StackPanel>
                <TextBlock Text="Avances partielles pas encore réglées en totalité et soldes dus après consultation."
                           FontSize="12" Foreground="#94A3B8" Margin="0,2,0,14"/>

                <DataGrid x:Name="dgIncomplets" AutoGenerateColumns="False" IsReadOnly="True" Height="230"
                          RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° paiement" Binding="{Binding NumeroAffiche}" Width="110"/>
                        <DataGridTextColumn Header="Patient" Binding="{Binding PatientNom}" Width="*"/>
                        <DataGridTextColumn Header="Montant à payer" Binding="{Binding MontantRestantAffiche}" Width="130"/>
                        <DataGridTemplateColumn Header="Alertes" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding AlerteAffichee}" FontSize="12" Padding="8,4" BorderThickness="0" Cursor="Hand"
                                            Background="Transparent" Foreground="#334155" Click="btnAlertePaiement_Click" Tag="{Binding NumeroRdv}"
                                            ToolTip="Créer une alerte de paiement pour ce rendez-vous"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Régler" Margin="0,0,6,0" Padding="10,4" FontSize="11"
                                                Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                Click="btnRegler_Click" Tag="{Binding}"/>
                                        <Button Content="Rejeter" Padding="10,4" FontSize="11"
                                                Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                Click="btnRejeter_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="txtMessage" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Historique -->
        <Border Background="White" CornerRadius="8" Padding="20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="History" Width="20" Height="20" Foreground="#2563EB" Margin="0,0,8,0"/>
                    <TextBlock Text="Historique des paiements réglés" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                </StackPanel>
                <DataGrid x:Name="dgHistorique" AutoGenerateColumns="False" IsReadOnly="True" Height="240"
                          RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° paiement" Binding="{Binding NumeroPaiement}" Width="110"/>
                        <DataGridTextColumn Header="Patient" Binding="{Binding PatientNom}" Width="*"/>
                        <DataGridTemplateColumn Header="Type" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="8,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TypePaiement}" Value="ACOMPTE">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TypeAffiche}" FontSize="10" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Réglé le" Binding="{Binding DateFacture, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
                        <DataGridTextColumn Header="Montant" Binding="{Binding MontantAffiche}" Width="100"/>
                        <DataGridTextColumn Header="Mode" Binding="{Binding ModePaiement}" Width="110"/>
                        <DataGridTemplateColumn Header="Facturation" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FacturationAffichee}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="Facturer" Padding="8,4" FontSize="11"
                                                Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0" Cursor="Hand"
                                                Click="btnFacturer_Click" Tag="{Binding NumeroPaiement}"
                                                Visibility="{Binding EstFacture, Converter={StaticResource BoolInverseToVisibility}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
