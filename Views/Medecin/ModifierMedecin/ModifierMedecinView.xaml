<Window x:Class="Patients.Views.Medecin.ModifierMedecin.ModifierMedecinView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    WindowStartupLocation="CenterScreen" Height="1000">
    <StackPanel>
        <TextBlock Text="Modification d'un médecin" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        
        <TextBlock x:Name="IdMedecinModif" Text="" FontSize="14" Height="32" Padding="6" Margin="10,10,10,10"/>
        
        <Grid Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/> 
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Nom " FontSize="12" Foreground="#4B5563" Margin="0,0,0,4" FontWeight="Bold" />
                <TextBox x:Name="NomModif"  Height="32" Padding="6"/>
            </StackPanel>

            <StackPanel Grid.Column="2" >
                <TextBlock Text="Prenom " FontSize="12" Foreground="#4B5563" Margin="0,0,0,4" FontWeight="Bold" />
                <TextBox x:Name="PrenomModif"  Height="32" Padding="6" Margin="0,0,0,0"/>
            </StackPanel> 
        </Grid>

        <Grid Margin="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Date de naissance" FontSize="12" Foreground="#4B5563" Margin="0,0,0,4" FontWeight="Bold"/>
                    <DatePicker x:Name="DateDeNaissanceModif" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Genre" FontSize="12" Foreground="#4B5563" Margin="0,0,0,4" FontWeight="Bold"/>
                    <ComboBox x:Name="GenreModif" Height="32" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Homme"/>
                        <ComboBoxItem Content="Femme"/>
                        <ComboBoxItem Content="Autre" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Adresse " FontSize="12" Foreground="#4B5563" Margin="0,0,0,4" FontWeight="Bold"/>
                    <TextBox x:Name="AdresseMedecinModif" Height="32" Padding="6" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Numéro de téléphone " FontSize="12" Foreground="#4B5563" Margin="0,0,0,4" FontWeight="Bold"/>
                    <TextBox x:Name="TelephoneMedecinModif" Height="32" Padding="6" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Adresse e-mail" FontSize="12" Foreground="#4B5563" Margin="0,0,0,4" FontWeight="Bold"/>
                    <TextBox x:Name="EmailMedecinModif" Height="32" Padding="6" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Margin="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Statut" FontSize="12" Foreground="#4B5563" Margin="0,0,0,4" FontWeight="Bold"/>
                    <TextBox x:Name="StatutMedecinModif" Height="32" Padding="6" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fonction" FontSize="12" Foreground="#4B5563" Margin="0,0,0,4" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ComboBoxFonction"
                            ItemsSource="{Binding CboListeFonction}"
                            DisplayMemberPath="nom_fonction"
                            SelectedValuePath="code_fonction"
                            SelectedValue="{Binding TXTCodeFonction}"
                            Width="250" 
                            Height="32"/>
                        <Button Content="  + Fonction  " Click="AjoutFOnction" Height="32" Background="#2563EB" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Margin="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Taux Horaire" FontSize="12" Foreground="#4B5563" Margin="0,0,0,4" FontWeight="Bold"/>
                    <TextBox x:Name="TauxHoraireMedecinModif" Height="32" Padding="6" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Numéro d'Ordre des Médecins" FontSize="12" Foreground="#4B5563" Margin="0,0,0,4" FontWeight="Bold"/>
                    <TextBox x:Name="numeroOrdreMedecinModif" Height="32" Padding="6" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        <Button Content="Enregistrer" Click="btnModifierMedecin_Click" Height="36" Background="#2563EB" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
        <TextBlock x:Name="txtMessageMedecin" Text="" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
</Window>


