
<UserControl x:Class="Patients.Views.Medecin.DetailEtDisponibilite.DetailMedecin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="650" Width="1050"
             Background="#F9FAFB">
    <Grid Background="#F3F4F6">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===================== COLONNE GAUCHE : INFOS MEDECIN ===================== -->
    <Grid Grid.Column="0">
        <StackPanel Margin="24">
            <TextBlock Text="Informations Médecin" FontSize="19" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="0,0,0,16"/>

            <Border BorderBrush="#E5E7EB" BorderThickness="1" Background="White" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#1E3A8A" Direction="270" ShadowDepth="2" BlurRadius="12" Opacity="0.08"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Matricule :" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TXTMatricule" Grid.Row="0" Grid.Column="1" FontWeight="Medium" Foreground="#111827" Margin="0,7" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="#E5E7EB"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Nom &amp; Prénom :" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,12,0,7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TXTIdentite" Grid.Row="1" Grid.Column="1" FontWeight="Medium" Foreground="#111827" Margin="0,12,0,7" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Date de naissance :" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TXTDateNaissance" Grid.Row="2" Grid.Column="1" FontWeight="Medium" Foreground="#111827" Margin="0,7" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Adresse :" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TXTAdress" Grid.Row="3" Grid.Column="1" FontWeight="Medium" Foreground="#111827" Margin="0,7" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Contact :" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TXTContact" Grid.Row="4" Grid.Column="1" FontWeight="Medium" Foreground="#111827" Margin="0,7" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Ordre des Médecins :" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TXTOrdreMedecin" Grid.Row="5" Grid.Column="1" FontWeight="Medium" Foreground="#111827" Margin="0,7" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Info :" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TXTInformationProfessionnel" Grid.Row="6" Grid.Column="1" FontWeight="Medium" Foreground="#111827" Margin="0,7" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Taux horaire :" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TXTTauxMhoraire" Grid.Row="7" Grid.Column="1" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,7" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>
            <!-- <Button Content="Fermer" Width="100" Height="30" Margin="0,20,0,0" HorizontalAlignment="Right" Click="BtnFermer_Click"/> -->
        </StackPanel>
    </Grid>

    <!-- ===================== COLONNE DROITE : NOUVELLE DISPONIBILITE ===================== -->
    <Grid Grid.Column="1">
        <StackPanel Margin="24">
            <TextBlock Text="Nouvelle disponibilité" FontSize="19" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="0,0,0,16"/>

            <Border BorderBrush="#E5E7EB" BorderThickness="1" Background="White" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#1E3A8A" Direction="270" ShadowDepth="2" BlurRadius="12" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Date :" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,7" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="0" Grid.Column="2" x:Name="TXTDateDisponibilite" Height="34" BorderBrush="#E5E7EB" Padding="6,4" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="180"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Heure de disponibilité :" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,7" VerticalAlignment="Top"/>
                        <StackPanel x:Name="pnlOptions" Grid.Row="2" Grid.Column="2">
                            <CheckBox Content="08h00 - 10h00" Tag="1" Margin="0,5" Padding="8,4" FontSize="13.5" Foreground="#111827"/>
                            <CheckBox Content="10h00 - 12h00" Tag="2" Margin="0,5" Padding="8,4" FontSize="13.5" Foreground="#111827"/>
                            <CheckBox Content="14h00 - 16h00" Tag="3" Margin="0,5" Padding="8,4" FontSize="13.5" Foreground="#111827"/>
                            <CheckBox Content="16h00 - 18h00" Tag="4" Margin="0,5" Padding="8,4" FontSize="13.5" Foreground="#111827"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Valider la sélection" Click="BtnValiderCreationDispo" Height="36" Background="#1E3A8A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,20,0,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Affichage du résultat -->
                    <TextBlock x:Name="txtResultat" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#1E3A8A" FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Grid>
</UserControl>