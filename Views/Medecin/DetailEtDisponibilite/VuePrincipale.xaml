<!-- Patients.Views.Medecin.MainViewModel -->

<Window x:Class="Patients.Views.Medecin.DetailEtDisponibilite.VuePrincipale"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Patients.Views.Medecin.DetailEtDisponibilite"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Information medecin"
    Height="650" Width="1050"
    WindowStartupLocation="CenterOwner"
    Background="#F9FAFB">

    <!-- 2. Déclaration des DataTemplates dans la fenêtre -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:DetailMedecin}">
            <local:DetailMedecin/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DashboardDispo}">
            <local:DashboardDispo/>
        </DataTemplate>
    </Window.Resources>

    <!-- 3. Structure de l'interface -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/> <!-- Menu latéral -->
            <RowDefinition />   <!-- Zone d'affichage dynamique -->
        </Grid.RowDefinitions>

        <!-- Menu latéral -->
        <StackPanel Grid.Row="0" Background="#F0F0F0" Orientation="Horizontal">
            <StackPanel>
                <Button Click="BtnMedecin_Click" Margin="10" Height="36" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Heart" 
                                                Width="22" 
                                                Height="22" 
                                                Foreground="#2563EB" 
                                                Margin="0,0,8,0" 
                                                VerticalAlignment="Center"/>
                        <TextBlock Text="Médecins" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel>
                <Button Click="BtnPatient_Click" Margin="10" Height="36" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" Foreground="#2563EB" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Patients" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ZONE DYNAMIQUE : Le ContentControl -->
        <ContentControl Grid.Row="1" 
                        Content="{Binding CurrentViewModel}" />
    </Grid>

</Window>