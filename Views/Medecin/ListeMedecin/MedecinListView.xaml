<UserControl x:Class="Patients.Views.Medecin.ListeMedecin.MaPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <DataGrid x:Name="dgSimple" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
            MouseDoubleClick="BtnOuvrirFenetre_Click">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Nom}" Width="*"/>
                <DataGridTextColumn Header="prenom" Binding="{Binding Prenom}" Width="*"/>
                <DataGridTextColumn Header="nom fonction" Binding="{Binding nom_fonction}" Width="*"/>
                <DataGridTextColumn Header="telephone" Binding="{Binding Telephone}" Width="*"/>
                <DataGridTemplateColumn Header="Action">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Tag="{Binding Id}" Content="Supprimer" Click="btnSupprimerMedecin" />
                                <Button Tag="{Binding Id}" Content="Modifier" Click="BtnOuvrirFenetre_Modification"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn> 
            </DataGrid.Columns>
        </DataGrid>
        </ScrollViewer>
	</Grid>
</UserControl>
