<UserControl x:Class="Patients.Views.RendezVous.RendezVousFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border Background="White" CornerRadius="8" Padding="20">
        <StackPanel>
            <TextBlock Text="Nouveau rendez-vous" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>

            <TextBlock Text="Patient" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
            <TextBox x:Name="txtRecherchePatient" Height="32" Padding="8,6" Margin="0,0,0,6" Tag="Rechercher..."
                     TextChanged="txtRecherchePatient_TextChanged"/>
            <ComboBox x:Name="cbPatient" Height="32" Margin="0,0,0,14" DisplayMemberPath="NomComplet"/>

            <TextBlock Text="Médecin" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
            <ComboBox x:Name="cbMedecin" Height="32" Margin="0,0,0,14" DisplayMemberPath="NomComplet"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Date" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpDate" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Heure (HH:mm)" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtHeure" Height="32" Padding="8,6" Text="09:00"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Motif" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
            <TextBox x:Name="txtMotif" Height="60" Padding="8,6" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>

            <TextBlock x:Name="txtMessage" Margin="0,0,0,10" FontSize="12" TextWrapping="Wrap"/>

            <Button Click="btnCreer_Click" Background="#2563EB" Foreground="White" BorderThickness="0"
                    Padding="16,8" HorizontalAlignment="Right" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Créer le rendez-vous" FontSize="13"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
