<UserControl x:Class="Patients.Views.RendezVous.RendezVousListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border Background="White" CornerRadius="8" Padding="15">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Liste des rendez-vous" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                <Button Grid.Column="1" Click="btnNouveau_Click" Background="#2563EB" Foreground="White" BorderThickness="0"
                        Padding="14,7" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlusCircleOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Nouveau rendez-vous" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Filtres -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtRecherche" Grid.Column="0" Height="32" Padding="8,6" Margin="0,0,10,0"
                         VerticalContentAlignment="Center" Tag="Rechercher un patient ou un médecin..."
                         TextChanged="Filtre_Changed"/>

                <DatePicker x:Name="dpDate" Grid.Column="1" Height="32" Margin="0,0,10,0"
                            SelectedDateChanged="Filtre_Changed"/>

                <ComboBox x:Name="cbStatut" Grid.Column="2" Height="32" SelectedIndex="0" SelectionChanged="Filtre_Changed">
                    <ComboBoxItem Content="Tous"/>
                    <ComboBoxItem Content="Planifié"/>
                    <ComboBoxItem Content="Annulé"/>
                    <ComboBoxItem Content="Terminé"/>
                </ComboBox>
            </Grid>

            <TextBlock Text="Double-clique sur une ligne pour voir le détail du rendez-vous."
                       FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8" FontStyle="Italic"/>

            <DataGrid x:Name="dgRendezVous" AutoGenerateColumns="False" IsReadOnly="True"
                      MouseDoubleClick="dgRendezVous_MouseDoubleClick" Height="330"
                      RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° RDV" Binding="{Binding NumeroRdv}" Width="90"/>
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientNom}" Width="*"/>
                    <DataGridTextColumn Header="Médecin" Binding="{Binding MedecinNom}" Width="*"/>
                    <DataGridTextColumn Header="Date &amp; heure" Binding="{Binding DateHeure, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                    <DataGridTemplateColumn Header="Statut" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CouleurStatut}" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatutAffiche}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Reprogrammer" Margin="0,0,6,0" Padding="8,4" FontSize="11"
                                            Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand"
                                            Click="btnReprogrammer_Click" Tag="{Binding NumeroRdv}"/>
                                    <Button Content="Annuler" Padding="8,4" FontSize="11"
                                            Background="#FEE2E2" Foreground="#B91C1C" BorderThickness="0" Cursor="Hand"
                                            Click="btnAnnuler_Click" Tag="{Binding NumeroRdv}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="txtMessage" Margin="0,10,0,0" FontSize="12"/>
        </StackPanel>
    </Border>
</UserControl>
