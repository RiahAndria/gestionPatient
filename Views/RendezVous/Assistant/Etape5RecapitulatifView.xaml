<UserControl x:Class="Patients.Views.RendezVous.Assistant.Etape5RecapitulatifView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Récapitulatif du rendez-vous" Style="{StaticResource TitreSection}"/>

        <StackPanel Grid.Row="1">
            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10"
                    Background="#F8FAFC" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="TxtPatient" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtService" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtMedecin" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtDateHeure" FontSize="13"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Motif de la consultation (optionnel)" Style="{StaticResource Libelle}"/>
            <TextBox x:Name="TxtMotif" Style="{StaticResource ChampSaisie}" Height="70" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="TxtErreur" Foreground="{StaticResource BrushDanger}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="280" TextWrapping="Wrap"/>
            <Button Content="← Précédent" Style="{StaticResource BoutonSecondaire}" Width="110" Margin="0,0,10,0" Click="BtnPrecedent_Click"/>
            <Button x:Name="BtnConfirmer" Content="Confirmer le rendez-vous" Style="{StaticResource BoutonPrimaire}" Width="190" Click="BtnConfirmer_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
