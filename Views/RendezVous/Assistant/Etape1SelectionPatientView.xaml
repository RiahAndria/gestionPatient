<UserControl x:Class="Patients.Views.RendezVous.Assistant.Etape1SelectionPatientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Phase 1 : carte d'introduction. Les donnees patient sont en
             lecture seule ici (elles viennent du module Patients). -->
        <Border x:Name="PanelIntro" Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                CornerRadius="10" Cursor="Hand" MouseLeftButtonUp="PanelIntro_Click"
                Width="320" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Sélectionner le patient" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock Text="Choisir un patient enregistré dans la base de données" FontSize="12"
                           Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,6,0,0" HorizontalAlignment="Center" MaxWidth="260"/>
            </StackPanel>
        </Border>

        <!-- Phase 2 : liste des patients. -->
        <Grid x:Name="PanelListe" Grid.Row="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&lt; Retour" Foreground="{StaticResource BrushPrimary}"
                           Cursor="Hand" MouseLeftButtonUp="Retour_Click" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBox x:Name="TxtRecherche" Grid.Column="1" Style="{StaticResource ChampSaisie}"
                         Tag="Rechercher un patient (nom, matricule)..." TextChanged="TxtRecherche_TextChanged"/>
            </Grid>

            <ListBox x:Name="ListePatients" Grid.Row="1" BorderThickness="0" Background="Transparent"
                     SelectionChanged="ListePatients_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="fond" BorderThickness="1" CornerRadius="8" Padding="14,10"
                                            BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushSurface}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="fond" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                            <Setter TargetName="fond" Property="Background" Value="#EFF6FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding NomComplet}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding NumeroDossier}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding AgeAffiche}" FontSize="12" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Genre}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="TxtErreur" Foreground="{StaticResource BrushDanger}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="BtnSuivant" Content="Suivant →" Style="{StaticResource BoutonPrimaire}"
                    Width="120" IsEnabled="False" Click="BtnSuivant_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
