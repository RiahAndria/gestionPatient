<UserControl x:Class="Patients.Views.RendezVous.Assistant.Etape6PaiementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Règlement du paiement" Style="{StaticResource TitreSection}"/>
            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10"
                    Background="#F8FAFC" Padding="16" Margin="0,0,0,16">
                <TextBlock x:Name="TxtMontantTotal" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Mode de règlement" Style="{StaticResource Libelle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="RadioEntier" Content="En entier" GroupName="TypeReglement" Margin="0,0,20,0"
                             Checked="TypeReglement_Changed" IsChecked="True"/>
                <RadioButton x:Name="RadioAvance" Content="En avance (minimum 60 %)" GroupName="TypeReglement"
                             Checked="TypeReglement_Changed"/>
            </StackPanel>

            <TextBlock x:Name="TxtInfoAvance" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                       Visibility="Collapsed" Margin="0,0,0,10"/>

            <TextBlock Text="Montant réglé (Ar)" Style="{StaticResource Libelle}"/>
            <TextBox x:Name="TxtMontant" Style="{StaticResource ChampSaisie}" Width="220" HorizontalAlignment="Left"
                     TextChanged="TxtMontant_TextChanged"/>

            <TextBlock Text="Méthode de paiement" Style="{StaticResource Libelle}" Margin="0,14,0,4"/>
            <ComboBox x:Name="CbModePaiement" Style="{StaticResource ComboSaisie}" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
                <ComboBoxItem Content="Espèces"/>
                <ComboBoxItem Content="Mobile Money"/>
                <ComboBoxItem Content="Chèque"/>
            </ComboBox>

            <TextBlock x:Name="TxtResteAPayer" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,0"
                       Foreground="{StaticResource BrushWarning}" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="TxtErreur" Foreground="{StaticResource BrushDanger}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="280" TextWrapping="Wrap"/>
            <Button Content="← Précédent" Style="{StaticResource BoutonSecondaire}" Width="110" Margin="0,0,10,0" Click="BtnPrecedent_Click"/>
            <Button x:Name="BtnValider" Content="Valider le paiement" Style="{StaticResource BoutonSucces}" Width="170" Click="BtnValider_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
