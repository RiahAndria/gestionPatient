<Window x:Class="Patients.Views.RendezVous.Assistant.NouveauRendezVousWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau rendez-vous" Height="640" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre de l'etape courante (ex: "Étape 3/7 — Type de rendez-vous") -->
        <TextBlock x:Name="TxtTitreEtape" Grid.Row="0" Style="{StaticResource TitrePage}" Margin="0,0,0,10"/>

        <!-- Barre de progression : 7 segments, actif = BrushPrimary -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Barre1" Grid.Column="0" Height="6" CornerRadius="3" Margin="0,0,4,0" Background="{StaticResource BrushBorder}"/>
            <Border x:Name="Barre2" Grid.Column="1" Height="6" CornerRadius="3" Margin="4,0" Background="{StaticResource BrushBorder}"/>
            <Border x:Name="Barre3" Grid.Column="2" Height="6" CornerRadius="3" Margin="4,0" Background="{StaticResource BrushBorder}"/>
            <Border x:Name="Barre4" Grid.Column="3" Height="6" CornerRadius="3" Margin="4,0" Background="{StaticResource BrushBorder}"/>
            <Border x:Name="Barre5" Grid.Column="4" Height="6" CornerRadius="3" Margin="4,0" Background="{StaticResource BrushBorder}"/>
            <Border x:Name="Barre6" Grid.Column="5" Height="6" CornerRadius="3" Margin="4,0" Background="{StaticResource BrushBorder}"/>
            <Border x:Name="Barre7" Grid.Column="6" Height="6" CornerRadius="3" Margin="4,0,0,0" Background="{StaticResource BrushBorder}"/>
        </Grid>

        <!-- Contenu de l'etape courante : chaque etape est un UserControl
             independant, echange dynamiquement par NouveauRendezVousWindow.xaml.cs -->
        <Border Grid.Row="2" Style="{StaticResource Carte}" Padding="24" Margin="0">
            <ContentControl x:Name="ContenuEtape"/>
        </Border>
    </Grid>
</Window>
