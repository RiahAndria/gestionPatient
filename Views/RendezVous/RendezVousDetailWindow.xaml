<Window x:Class="Patients.Views.RendezVous.RendezVousDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Détail du rendez-vous" Height="650" Width="820"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True" WindowStyle="None" Background="Transparent">

    <Window.Resources>
        <Style x:Key="GlassSection" TargetType="Border">
            <Setter Property="Background" Value="#B2FFFFFF"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.05" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LigneInfo" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="25" Background="#F0F4F8" BorderBrush="#2563EB" BorderThickness="1">
        <Grid>
            <Image Source="/Assets/bg.jpg" Stretch="UniformToFill" Opacity="0.1">
                <Image.Effect><BlurEffect Radius="20"/></Image.Effect>
            </Image>

            <DockPanel Margin="20">
                <!-- En-tete -->
                <Border DockPanel.Dock="Top" Height="60" Margin="0,0,0,6">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="lblNumeroRdv" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                            <Border x:Name="badgeStatut" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock x:Name="lblStatut" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Click="BtnFermer_Click" Cursor="Hand">
                            <materialDesign:PackIcon Kind="CloseCircle" Foreground="#64748B" Width="24" Height="24"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Barre d'actions -->
                <Border DockPanel.Dock="Bottom" Height="60" Margin="0,6,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Content="Reprogrammer" Click="BtnReprogrammer_Click" Height="38" Width="140" Margin="0,0,10,0"
                                    Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Changer Statut" Click="BtnChangerStatut_Click" Height="38" Width="140" Margin="0,0,10,0"
                                    Background="#D97706" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Supprimer" Click="BtnSupprimer_Click" Height="38" Width="130"
                                    Background="#DC2626" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                        <Button Content="Fermer" Click="BtnFermer_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Height="38" Width="100" Background="#64748B" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Contenu : 2 colonnes x 2 lignes -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Rendez-vous -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="CalendarClockOutline" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Rendez-vous" FontWeight="Bold" Foreground="#334155"/>
                                </StackPanel>
                                <TextBlock x:Name="lblDateHeure" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock x:Name="lblMotif" TextWrapping="Wrap" FontSize="13" FontStyle="Italic" Foreground="#475569"/>
                                <TextBlock x:Name="lblMotifAnnulation" TextWrapping="Wrap" FontSize="13" Foreground="#B91C1C" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Patient -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="AccountOutline" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Patient" FontWeight="Bold" Foreground="#334155"/>
                                </StackPanel>
                                <TextBlock x:Name="lblPatientNom" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="lblPatientMatricule" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock x:Name="lblPatientContact" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Medecin -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="Doctor" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Médecin" FontWeight="Bold" Foreground="#334155"/>
                                </StackPanel>
                                <TextBlock x:Name="lblMedecinNom" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="lblMedecinFonction" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- Paiement -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Paiement" FontWeight="Bold" Foreground="#334155"/>
                                </StackPanel>

                                <Grid Style="{StaticResource LigneInfo}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Montant total" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" x:Name="lblMontantTotal" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Style="{StaticResource LigneInfo}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Montant payé" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" x:Name="lblMontantPaye" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A"/>
                                </Grid>
                                <Grid Style="{StaticResource LigneInfo}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Montant non payé" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" x:Name="lblMontantNonPaye" FontSize="12" FontWeight="SemiBold" Foreground="#DC2626"/>
                                </Grid>
                                <Grid x:Name="ligneDateLimite" Style="{StaticResource LigneInfo}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Date limite de paiement" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" x:Name="lblDateLimite" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Style="{StaticResource LigneInfo}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Mode de paiement" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" x:Name="lblModePaiement" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>

                                <TextBlock x:Name="lblAucunPaiement" Text="Aucun paiement enregistré pour ce rendez-vous." FontSize="12"
                                           Foreground="#94A3B8" FontStyle="Italic" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
