<Window x:Class="Patients.Views.RendezVous.RendezVousDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Détail du rendez-vous" Height="560" Width="620"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True" WindowStyle="None" Background="Transparent">

    <Window.Resources>
        <Style x:Key="GlassSection" TargetType="Border">
            <Setter Property="Background" Value="#B2FFFFFF"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.05" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="25" Background="#F0F4F8" BorderBrush="#2563EB" BorderThickness="1">
        <Grid>
            <Image Source="/Assets/bg.jpg" Stretch="UniformToFill" Opacity="0.1">
                <Image.Effect><BlurEffect Radius="20"/></Image.Effect>
            </Image>

            <DockPanel Margin="20">
                <Border DockPanel.Dock="Top" Height="70" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="lblNumeroRdv" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                            <Border x:Name="badgeStatut" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock x:Name="lblStatut" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Click="BtnFermer_Click">
                            <materialDesign:PackIcon Kind="CloseCircle" Foreground="#64748B" Width="24" Height="24"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel>
                    <Border Style="{StaticResource GlassSection}">
                        <StackPanel>
                            <TextBlock Text="Rendez-vous" FontWeight="Bold" Margin="0,0,0,10" Foreground="#334155"/>
                            <TextBlock x:Name="lblDateHeure" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblMotif" TextWrapping="Wrap" FontSize="13" FontStyle="Italic" Foreground="#475569"/>
                            <TextBlock x:Name="lblMotifAnnulation" TextWrapping="Wrap" FontSize="13" Foreground="#B91C1C" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource GlassSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="AccountOutline" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Patient" FontWeight="Bold" Foreground="#334155"/>
                                </StackPanel>
                                <TextBlock x:Name="lblPatientNom" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="lblPatientMatricule" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock x:Name="lblPatientContact" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource GlassSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="Doctor" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Médecin" FontWeight="Bold" Foreground="#334155"/>
                                </StackPanel>
                                <TextBlock x:Name="lblMedecinNom" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="lblMedecinFonction" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource GlassSection}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Paiements liés" FontWeight="Bold" Foreground="#334155"/>
                            </StackPanel>
                            <ItemsControl x:Name="listePaiements">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TypePaiementAffiche}" FontSize="12" Foreground="#475569"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MontantAffiche}" FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="2" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Payé"/>
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstPaye}" Value="False">
                                                                <Setter Property="Text" Value="En attente"/>
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="lblAucunPaiement" Text="Aucun paiement enregistré pour ce rendez-vous." FontSize="12" Foreground="#94A3B8" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
