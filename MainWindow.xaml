<Window x:Class="Patients.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sidebar="clr-namespace:Patients.Views.Components"
        xmlns:patient="clr-namespace:Patients.Views.Patient"
        xmlns:patientForm="clr-namespace:Patients.Views.Patient.Forms"
        xmlns:components="clr-namespace:Patients.Views.Patient.Components"
        xmlns:medecin="clr-namespace:Patients.Views.Medecin"
        xmlns:dossier="clr-namespace:Patients.Views.DossierMedical"
        xmlns:historique="clr-namespace:Patients.Views.Historique"
        xmlns:rendezvous="clr-namespace:Patients.Views.RendezVous"
        xmlns:paiement="clr-namespace:Patients.Views.Paiement"
        xmlns:notification="clr-namespace:Patients.Views.Notification"
        xmlns:consultation="clr-namespace:Patients.Views.Consultation"
        xmlns:listeMedecin="clr-namespace:Patients.Views.Medecin.ListeMedecin"
        Title="Gestion Médicale" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#CCFFFFFF"/> <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.08" ShadowDepth="4" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Image Source="/Assets/bg.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
        
        <Rectangle Fill="#150F172A"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <sidebar:SidebarView x:Name="SidebarNav" Grid.Column="0"/>

            <Grid Grid.Column="1" Margin="12,24,24,24">
                <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabItem x:Name="TabPatients">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Gestion des Patients" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>
                                
                                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,20">
                                    <patientForm:PatientFormView x:Name="PatientForm"/>
                                </Border>

                                <Border Style="{StaticResource GlassCardStyle}">
                                    <components:TableauPatient x:Name="PatientList"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="TabMedecins">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Corps Médical" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>
                                <Border Style="{StaticResource GlassCardStyle}">
                                    <medecin:MedecinFormView/>
                                </Border>
                                <Border Style="{StaticResource GlassCardStyle}">
                                    <listeMedecin:MaPage />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="TabConsultations">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Consultations" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>
                                <Border Style="{StaticResource GlassCardStyle}">
                                    <consultation:ConsultationView/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="TabRendezVous">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Planning &amp; Rendez-vous" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>
                                <Border Style="{StaticResource GlassCardStyle}">
                                    <rendezvous:RendezVousListView x:Name="VueRendezVous"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="TabPaiements">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Paiements" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>
                                <Border Style="{StaticResource GlassCardStyle}">
                                    <paiement:PaiementView x:Name="VuePaiements"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="TabNotifications">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Notifications" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>
                                <Border Style="{StaticResource GlassCardStyle}">
                                    <notification:NotificationView x:Name="VueNotifications"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
